{
  "rules": [
    {
      "provider": "github-copilot",
      "action": "allow",
      "match": {
        "ids": [
          "gpt-5.6-sol",
          "gpt-5.6-terra",
          "gpt-5.6-luna",
          "gpt-5.4-mini",
          "gpt-5.3-codex"
        ]
      }
    },
    {
      "provider": "github-copilot",
      "action": "block",
      "match": {
        "patterns": [
          "**"
        ]
      }
    },
    {
      "provider": "amazon-bedrock",
      "action": "allow",
      "match": {
        "patterns": [
          "us.anthropic.claude-sonnet-4-6*",
          "us.anthropic.claude-sonnet-5*",
          "us.anthropic.claude-opus-4-8*",
          "us.anthropic.claude-opus-5*",
          "us.anthropic.claude-haiku-*"
        ]
      }
    },
    {
      "provider": "amazon-bedrock",
      "action": "block",
      "match": {
        "patterns": [
          "**"
        ]
      }
    },
    {
      "provider": "ollama",
      "action": "allow",
      "match": {
        "ids": [
          "gemma4:31b-cloud",
          "gpt-oss:20b-cloud"
        ]
      }
    },
    {
      "provider": "ollama",
      "action": "block",
      "match": {
        "patterns": [
          "*"
        ]
      }
    }
  ]
}

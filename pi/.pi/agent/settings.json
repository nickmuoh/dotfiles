{
  "theme": "dark",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:@narumitw/pi-btw",
    "npm:@nguyenquangthai/pi-subtask",
    "npm:@pi-kaush/pi-welcome-screen@latest",
    "npm:pi-context-tools",
    "npm:pi-context-view",
    "npm:pi-double-esc",
    "npm:pi-env",
    "npm:pi-intercom",
    "npm:pi-mcp-adapter",
    "npm:pi-prompt-template-model",
    "npm:pi-quiet-tools",
    "npm:pi-subagents",
    "npm:pi-web-access",
    {
      "source": "npm:@m4riok/pi-ide-bridge",
      "extensions": [
        "-index.ts"
      ]
    },
    "git:github.com/DietrichGebert/ponytail"
  ],
  "hideThinkingBlock": false,
  "ollama": {
    "baseUrl": "http://172.17.48.1:11435",
    "cloudUrl": "https://ollama.com",
    "apiKey": "ollama"
  },
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "amazon-bedrock",
  "defaultModel": "us.anthropic.claude-sonnet-5",
  "defaultThinkingLevel": "medium",
  "env": {
    "FFF_ENABLE_HOME_SCAN": "0",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_PROFILE": "claude-bedrock",
    "AWS_REGION": "us-west-2"
  },
  "fullscreenExitOutput": "transcript",
  "fullscreenScrollbar": "auto"
}
{
  "awsCredentialExport": "aws sts assume-role --role-arn arn:aws:iam::050402647616:role/SuOps-BedrockInvokeRole --role-session-name claude --profile claude",
  "awsAuthRefresh": "aws sso login --profile claude",
  "env": {
    "AWS_PROFILE": "claude",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "us-west-2"
  },
  "model": "us.anthropic.claude-sonnet-5",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state off"
          },
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state running"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state needs-input"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${TMUX_AGENT_INDICATOR_DIR:-$HOME/.tmux/plugins/tmux-agent-indicator}\"/scripts/agent-state.sh --agent claude --state done"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "uv run ~/.claude/claude-statusline-tracker.py"
  },
  "enabledPlugins": {
    "miro@claude-plugins-official": true,
    "snowflake-cortex-code@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "mc-agent-toolkit@mc-marketplace": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "mc-marketplace": {
      "source": {
        "source": "github",
        "repo": "monte-carlo-data/mc-agent-toolkit"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "medium"
    }
  },
  "autoCompactWindow": 500000,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "autoCompactEnabled": true
}

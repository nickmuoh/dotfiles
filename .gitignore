# Generated or cloned content
**/plug/
**/lazy/
**/tpm/
**/.cache/
**/.local/state/
**/.local/share/

# Agent workspace
/.local/
/.cortex/
/.pi/
agents/.agents/skills/

# Editor cruft
*.swp
*.swo
*.tmp

# Micro runtime files
micro/.config/micro/buffers/
micro/.config/micro/backups/

# User-specific configuration
.local/

# Track stowed helper scripts in the local-bin package
!/local-bin/.local/
!/local-bin/.local/bin/
!/local-bin/.local/bin/*

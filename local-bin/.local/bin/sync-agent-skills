#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: sync-agent-skills [options]

Options:
  -n, --dry-run   Print the skills that would be installed
  -h, --help      Show this help message

Environment:
  LOCKFILE        Override the lockfile path (default: ~/.agents/.skill-lock.json)
EOF
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'sync-agent-skills: missing required command: %s\n' "$1" >&2
    exit 1
  }
}

DRY_RUN=0
LOCKFILE="${LOCKFILE:-$HOME/.agents/.skill-lock.json}"

for arg in "$@"; do
  case "$arg" in
    -n|--dry-run)
      DRY_RUN=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf 'sync-agent-skills: unknown argument: %s\n' "$arg" >&2
      usage >&2
      exit 1
      ;;
  esac
done

need_cmd jq
need_cmd npx

if [ ! -f "$LOCKFILE" ]; then
  printf 'sync-agent-skills: missing lockfile: %s\n' "$LOCKFILE" >&2
  exit 1
fi

mapfile -t source_groups < <(
  jq -r '
    .skills
    | to_entries
    | group_by(.value.source)
    | .[]
    | [.[0].value.source, (map(.key) | join(" "))]
    | @tsv
  ' "$LOCKFILE"
)

if [ "${#source_groups[@]}" -eq 0 ]; then
  printf 'sync-agent-skills: no skills found in %s\n' "$LOCKFILE" >&2
  exit 0
fi

for entry in "${source_groups[@]}"; do
  source="${entry%%$'\t'*}"
  skill_list="${entry#*$'\t'}"
  read -r -a skills <<< "$skill_list"

  if [ "$DRY_RUN" -eq 1 ]; then
    printf 'sync-agent-skills: would install %s -> %s\n' "$source" "$skill_list"
  else
    printf 'sync-agent-skills: installing %s -> %s\n' "$source" "$skill_list"
    npx skills add "$source" -g -y --skill "${skills[@]}"
  fi
done

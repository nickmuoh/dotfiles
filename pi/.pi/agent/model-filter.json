{
  "rules": [
    {
      "provider": "github-copilot",
      "action": "allow",
      "match": {
        "ids": [
          "claude-opus-4.8",
          "claude-sonnet-4.6",
          "claude-fable-5",
          "gpt-5.6-sol",
          "gpt-5.6-terra",
          "gpt-5.6-luna",
          "gpt-5.4-mini",
          "gpt-5.3-codex"
        ]
      }
    },
    {
      "provider": "github-copilot",
      "action": "block",
      "match": {
        "patterns": [
          "**"
        ]
      }
    }
  ]
}
